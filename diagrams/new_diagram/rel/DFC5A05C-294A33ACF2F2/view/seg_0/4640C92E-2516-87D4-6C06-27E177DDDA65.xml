<TableView class="oracle.dbtools.crest.model.design.relational.TableView" directorySegmentName="seg_0" id="4640C92E-2516-87D4-6C06-27E177DDDA65" name="v_track_availability_viewv2">
<sourceDDLFile>init_views.sql</sourceDDLFile>
<createdBy>rv</createdBy>
<createdTime>2026-02-07 16:46:26 UTC</createdTime>
<ownerDesignName>new_diagram</ownerDesignName>
<ordsAlias>v_track_availability</ordsAlias>
<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT 
    t.id AS track_id,
    t.name AS track_name,
    t.max_karts,
    bp.booking_date,
    bp.time_slots_id,
    ts.start_time,
    ts.end_time,
    NVL(SUM(CASE WHEN b.status IN ('CONFIRMED', 'PENDING', 'RESERVED') 
                 THEN bp.quantity ELSE 0 END), 0) AS booked_karts,
    t.max_karts - NVL(SUM(CASE WHEN b.status IN ('CONFIRMED', 'PENDING', 'RESERVED') 
                               THEN bp.quantity ELSE 0 END), 0) AS available_karts
FROM tracks t
CROSS JOIN time_slots ts
CROSS JOIN (
    -- Generate dates for next 90 days
    SELECT TRUNC(SYSDATE) + LEVEL - 1 AS booking_date
    FROM DUAL
    CONNECT BY LEVEL <= 90
) dates
LEFT JOIN booked_places bp 
    ON t.id = bp.tracks_id 
    AND ts.id = bp.time_slots_id 
    AND dates.booking_date = bp.booking_date
LEFT JOIN bookings b 
    ON bp.bookings_id = b.id
WHERE t.is_active = 1
GROUP BY t.id, t.name, t.max_karts, bp.booking_date, bp.time_slots_id, ts.start_time, ts.end_time]]></userDefinedSQL>
